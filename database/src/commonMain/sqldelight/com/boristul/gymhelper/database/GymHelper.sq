CREATE TABLE workout_session (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    status TEXT NOT NULL
);

CREATE TABLE workout_stage (
    id TEXT NOT NULL PRIMARY KEY,
    workout_id TEXT NOT NULL REFERENCES workout_session(id) ON DELETE CASCADE,
    description TEXT NOT NULL,
    position INTEGER NOT NULL
);

CREATE TABLE workout_set (
    id TEXT NOT NULL PRIMARY KEY,
    stage_id TEXT NOT NULL REFERENCES workout_stage(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    weight_kg REAL NOT NULL,
    reps INTEGER NOT NULL
);

CREATE TABLE body_weight_entry (
    id TEXT NOT NULL PRIMARY KEY,
    entry_date TEXT NOT NULL UNIQUE,
    weight_kg REAL NOT NULL
);

selectWorkoutSession:
SELECT *
FROM workout_session
WHERE id = ?;

selectStagesForWorkout:
SELECT *
FROM workout_stage
WHERE workout_id = ?
ORDER BY position ASC;

selectSetsForStage:
SELECT *
FROM workout_set
WHERE stage_id = ?
ORDER BY position ASC;

insertWorkoutSession:
INSERT OR IGNORE INTO workout_session(id, title, status)
VALUES (?, ?, ?);

updateWorkoutStatus:
UPDATE workout_session
SET status = ?
WHERE id = ?;

insertWorkoutStage:
INSERT INTO workout_stage(id, workout_id, description, position)
VALUES (?, ?, ?, ?);

updateWorkoutStage:
UPDATE workout_stage
SET description = ?
WHERE id = ?;

updateStagePosition:
UPDATE workout_stage
SET position = ?
WHERE id = ?;

deleteWorkoutStage:
DELETE FROM workout_stage
WHERE id = ?;

deleteSetsForStage:
DELETE FROM workout_set
WHERE stage_id = ?;

insertWorkoutSet:
INSERT INTO workout_set(id, stage_id, position, weight_kg, reps)
VALUES (?, ?, ?, ?, ?);

selectBodyWeightEntries:
SELECT *
FROM body_weight_entry
ORDER BY entry_date DESC;

upsertTodayBodyWeight:
INSERT OR REPLACE INTO body_weight_entry(id, entry_date, weight_kg)
VALUES ('body-weight-' || date('now', 'localtime'), date('now', 'localtime'), ?);

deleteBodyWeightEntry:
DELETE FROM body_weight_entry
WHERE id = ?;
